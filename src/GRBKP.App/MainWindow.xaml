<Window x:Class="GRBKP.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GR BKP" Width="1000" Height="720" MinWidth="900" MinHeight="650"
        WindowStartupLocation="CenterScreen" Background="{StaticResource AppBackgroundBrush}">

    <!--
        Estrutura reaproveitada da v0.9 (cabecalho com logo, painel central com paginas
        alternadas por Visibility, rodape com faixa de marcas). O conteudo de cada pagina
        foi redesenhado do zero para o fluxo real da v1.0: descobrir perfis num SSD antigo
        e migrar dados/apps para o destino, em vez do fluxo generico usuario-para-usuario
        da v0.9 (decisao explicita do responsavel, 2026-09-12).
    -->
    <Grid Margin="28,18" Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="128" />
            <RowDefinition Height="*" />
            <RowDefinition Height="62" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Image x:Name="MainLogoImage" MaxHeight="116" Stretch="Uniform" Visibility="Collapsed" />
            <TextBlock x:Name="LogoFallback" Text="GR BKP" HorizontalAlignment="Center"
                       VerticalAlignment="Center" Foreground="Black" FontFamily="Arial Black"
                       FontStyle="Italic" FontSize="72" FontWeight="Black" />
        </Grid>

        <Grid Grid.Row="1">
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="2" CornerRadius="28" Padding="34,26">
                <Grid>

                    <!-- Pagina inicial -->
                    <Grid x:Name="HomePage">
                        <StackPanel Width="420" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="O que deseja fazer?" Foreground="White" FontSize="27"
                                       FontWeight="Bold" TextAlignment="Center" Margin="0,0,0,24" />
                            <Button Click="GoToBackupSource_Click" HorizontalAlignment="Stretch" Margin="44,0,44,14">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Fazer backup de um SSD" VerticalAlignment="Center" />
                                    <Image x:Name="StartBackupIcon" Width="20" Height="20" Visibility="Collapsed"
                                           Stretch="Uniform" Margin="8,0,0,0"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                </StackPanel>
                            </Button>
                            <Button Click="GoToRestoreSource_Click" HorizontalAlignment="Stretch" Margin="44,0,44,14">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Restaurar um backup" VerticalAlignment="Center" />
                                    <Image x:Name="ExtractBackupIcon" Width="20" Height="20" Visibility="Collapsed"
                                           Stretch="Uniform" Margin="8,0,0,0"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource SecondaryButton}" Click="GoToVerify_Click"
                                    HorizontalAlignment="Stretch" Margin="44,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Conferir um backup" VerticalAlignment="Center" />
                                    <Image x:Name="VerifyBackupIcon" Width="20" Height="20" Visibility="Collapsed"
                                           Stretch="Uniform" Margin="8,0,0,0"
                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                </StackPanel>
                            </Button>
                            <TextBlock Text="Confira antes de formatar o SSD antigo."
                                       Foreground="#FFE5F7FF" FontSize="13" TextAlignment="Center"
                                       Margin="0,10,0,0" />
                        </StackPanel>
                    </Grid>

                    <!-- Conferir backup -->
                    <Grid x:Name="VerifyPage" Visibility="Collapsed">
                        <StackPanel Width="650" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="Conferir um backup" Foreground="White" FontSize="27"
                                       FontWeight="Bold" TextAlignment="Center" />
                            <TextBlock Text="Relê o pacote inteiro e confirma se está tudo lá, do tamanho certo. Faça isso antes de formatar o SSD antigo."
                                       Foreground="#FFE5F7FF" FontSize="15" TextAlignment="Center"
                                       TextWrapping="Wrap" Margin="0,8,0,16" />
                            <TextBlock Text="Pasta do backup" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="VerifyPackageTextBox" />
                                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}"
                                        Content="Procurar" Click="BrowseVerifyPackage_Click" Margin="10,0,0,0" />
                            </Grid>
                            <TextBlock x:Name="VerifyStatusText" Foreground="#FFFFE8A3" FontSize="14"
                                       TextWrapping="Wrap" Margin="0,14,0,0" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0">
                                <Button Style="{StaticResource SecondaryButton}" Content="Voltar"
                                        Click="GoHome_Click" Margin="0,0,10,0" />
                                <Button x:Name="VerifyButton" Content="Conferir agora" Click="VerifyPackage_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- Backup: origem -->
                    <Grid x:Name="BackupSourcePage" Visibility="Collapsed">
                        <StackPanel Width="650" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="De onde vamos copiar?" Foreground="White" FontSize="27"
                                       FontWeight="Bold" TextAlignment="Center" />
                            <TextBlock Text="Informe a unidade do SSD antigo (ex.: F:\)."
                                       Foreground="#FFE5F7FF" FontSize="16" TextAlignment="Center" Margin="0,8,0,16" />
                            <TextBlock Text="Unidade de origem" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="SourceVolumeTextBox" Text="F:\" />
                                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Selecionar outro SSD…"
                                        Click="BrowseSourceVolume_Click" Margin="10,0,0,0" Padding="14,8" />
                            </Grid>
                            <Border Background="#55203D50" CornerRadius="10" Padding="10" Margin="0,10,0,14">
                                <TextBlock x:Name="BackupSourceStatusText" Foreground="#FFEAF9FF" TextWrapping="Wrap"
                                           Text="Informe a unidade e clique em Buscar perfis." />
                            </Border>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Style="{StaticResource SecondaryButton}" Content="Voltar"
                                        Click="GoHome_Click" Margin="0,0,10,0" />
                                <Button x:Name="SearchProfilesButton" Content="Buscar perfis"
                                        Click="SearchProfiles_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- Backup: escolha de perfil e destino -->
                    <Grid x:Name="BackupProfilePage" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="Selecione o perfil" Foreground="White" FontSize="25" FontWeight="Bold" />
                            <TextBlock Text="Perfis reais do funcionário aparecem destacados. Pastas de sistema/molde ou suspeitas ficam desabilitadas."
                                       Foreground="#FFE5F7FF" FontSize="15" Margin="0,5,0,14" TextWrapping="Wrap" />
                        </StackPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="ProfileListPanel" />
                        </ScrollViewer>
                        <StackPanel Grid.Row="2" Margin="0,14,0,0">
                            <TextBlock Text="Nome da pessoa ou identificação do backup" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <TextBox x:Name="PersonNameTextBox" MaxLength="80" Margin="0,0,0,10" />
                            <TextBlock Text="Pasta de destino do backup" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="BackupDestinationTextBox" />
                                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Procurar…"
                                        Click="BrowseBackupDestination_Click" Margin="10,0,0,0" Padding="14,8" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource SecondaryButton}" Content="Voltar"
                                        Click="GoToBackupSource_Click" Margin="0,0,10,0" />
                                <Button x:Name="StartBackupButton" Content="Iniciar backup" Click="StartBackup_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- Restaurar: origem e destino -->
                    <Grid x:Name="RestoreSourcePage" Visibility="Collapsed">
                        <StackPanel Width="700" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="Restaurar um backup" Foreground="White" FontSize="25" FontWeight="Bold"
                                       TextAlignment="Center" />
                            <TextBlock Text="Informe a pasta do backup e o perfil de destino no SSD novo."
                                       Foreground="#FFE5F7FF" FontSize="15" TextAlignment="Center" Margin="0,5,0,18" />
                            <TextBlock Text="Pasta do backup (pacote)" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="RestorePackageTextBox" />
                                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Procurar…"
                                        Click="BrowseRestorePackage_Click" Margin="10,0,0,0" Padding="14,8" />
                            </Grid>
                            <TextBlock Text="Pasta do perfil de destino" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="RestoreDestinationTextBox" />
                                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Procurar…"
                                        Click="BrowseRestoreDestination_Click" Margin="10,0,0,0" Padding="14,8" />
                            </Grid>
                            <Border Background="#55203D50" CornerRadius="10" Padding="10" Margin="0,0,0,14">
                                <TextBlock x:Name="RestoreSourceStatusText" Foreground="#FFEAF9FF" TextWrapping="Wrap"
                                           Text="Informe as duas pastas e clique em Prosseguir." />
                            </Border>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Style="{StaticResource SecondaryButton}" Content="Voltar"
                                        Click="GoHome_Click" Margin="0,0,10,0" />
                                <Button Content="Prosseguir" Click="RestoreSourceNext_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- Restaurar: confirmacao -->
                    <Grid x:Name="RestoreConfirmPage" Visibility="Collapsed">
                        <StackPanel Width="700" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="Confirmar restauração?" Foreground="White" FontSize="25"
                                       FontWeight="Bold" TextAlignment="Center" />
                            <TextBlock x:Name="RestoreConfirmationDetails" Foreground="#FFE5F7FF" FontSize="16"
                                       TextAlignment="Center" TextWrapping="Wrap" Margin="0,16,0,20" />
                            <Border Background="#55304E61" BorderBrush="#88A8E5FF" BorderThickness="1"
                                    CornerRadius="12" Padding="16" Margin="0,0,0,22">
                                <TextBlock Foreground="#FFFFE8A3" TextAlignment="Center" TextWrapping="Wrap"
                                           Text="Arquivos de mesmo nome serão substituídos. Thunderbird/Firefox/Chrome/Edge encontrados no destino serão fechados antes da restauração." />
                            </Border>
                            <!--
                                Escolha do que restaurar. Nasceu de um caso real: numa restauração
                                de 50 GB um aplicativo ficou para trás, e recuperá-lo exigiria
                                repetir tudo. Cada aplicativo é uma troca de árvore independente,
                                então dá para refazer só o que faltou.
                            -->
                            <Border Background="#33123B55" BorderBrush="#554E9BC4" BorderThickness="1"
                                    CornerRadius="10" Padding="14,10" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="O que restaurar" Foreground="#FF9AE7FF" FontSize="14"
                                               FontWeight="Bold" Margin="0,0,0,6" />
                                    <CheckBox x:Name="RestorePersonalFilesCheckBox" IsChecked="True"
                                              Content="Arquivos pessoais (Documentos, Área de Trabalho, Downloads, Imagens)"
                                              Foreground="White" FontSize="14" Margin="0,0,0,4" />
                                    <WrapPanel x:Name="RestoreModulesPanel" Orientation="Horizontal" />
                                </StackPanel>
                            </Border>

                            <CheckBox x:Name="CorporateCleanupCheckBox" IsChecked="True"
                                      Content="Remover OneDrive e Copilot deste computador (política padrão da empresa)"
                                      Foreground="White" FontSize="15" HorizontalAlignment="Center"
                                      Margin="0,0,0,18" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Style="{StaticResource SecondaryButton}" Content="Voltar"
                                        Click="RestoreConfirmBack_Click" Margin="0,0,10,0" />
                                <Button Content="Confirmar e restaurar" Click="ConfirmRestore_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- Progresso (compartilhada entre backup e restauracao) -->
                    <Grid x:Name="ProgressPage" Visibility="Collapsed">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="ProgressTitleText" Text="Trabalhando..." Foreground="White" FontSize="27"
                                       FontWeight="Bold" TextAlignment="Center" />
                            <Grid Width="76" Height="76" Margin="0,12" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform><RotateTransform x:Name="LoadingRotation" /></Grid.RenderTransform>
                                <Ellipse Width="64" Height="64" Stroke="#446ED5F5" StrokeThickness="7" />
                                <Path Stroke="#FF9AE7FF" StrokeThickness="7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M 38,6 A 32,32 0 0 1 70,38" />
                            </Grid>
                            <!--
                                Barra de progresso real: o total de bytes é conhecido antes de
                                copiar (medição prévia no backup, contadores do pacote na
                                restauração). Enquanto o total ainda não é conhecido — durante a
                                própria medição — a barra fica indeterminada.
                            -->
                            <ProgressBar x:Name="OperationProgressBar" Width="520" Height="16"
                                         Minimum="0" Maximum="100" Margin="0,6,0,0"
                                         Background="#332A5878" BorderBrush="#88A8E5FF"
                                         BorderThickness="1" Foreground="#FF6ED5F5" />
                            <TextBlock x:Name="ProgressAmountText" Foreground="White" FontSize="17"
                                       FontWeight="SemiBold" TextAlignment="Center" Margin="0,10,0,0" />
                            <TextBlock x:Name="ProgressDetailsText" Foreground="#FFBFE6F7" FontSize="13"
                                       TextAlignment="Center" TextWrapping="Wrap" Margin="20,6,20,0" />
                        </StackPanel>
                    </Grid>

                    <!-- Resultado (compartilhada entre backup e restauracao) -->
                    <Grid x:Name="ResultPage" Visibility="Collapsed">
                        <StackPanel VerticalAlignment="Center" Width="720">
                            <Grid Height="74" Margin="0,0,0,2">
                                <Image x:Name="ResultSuccessIcon" MaxHeight="66" Stretch="Uniform"
                                       Visibility="Collapsed"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                                <TextBlock x:Name="ResultIconText" Text="✓" Foreground="#FF8AF0A5" FontSize="62"
                                           FontWeight="Bold" TextAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock x:Name="ResultTitleText" Foreground="White" FontSize="27" FontWeight="Bold"
                                       TextAlignment="Center" />

                            <!-- Linha de destaque: o número que o técnico olha primeiro. -->
                            <TextBlock x:Name="ResultHeadlineText" Foreground="#FF9AE7FF" FontSize="19"
                                       FontWeight="SemiBold" TextAlignment="Center" Margin="0,8,0,0" />

                            <!--
                                Blocos montados em código, cada um com título e linhas próprias.
                                Antes era tudo um parágrafo único centralizado, onde caminho de
                                pasta, aviso e lista de erro se misturavam.
                            -->
                            <Border Background="#33123B55" BorderBrush="#554E9BC4" BorderThickness="1"
                                    CornerRadius="12" Padding="18,14" Margin="0,14,0,0"
                                    MaxHeight="250">
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel x:Name="ResultDetailsPanel" />
                                </ScrollViewer>
                            </Border>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                                <Button x:Name="OpenFailureReportButton" Style="{StaticResource SecondaryButton}"
                                        Content="Ver relatório de erros" Click="OpenFailureReport_Click"
                                        Visibility="Collapsed" Margin="0,0,10,0" />
                                <Button Content="Finalizar" Click="Finish_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Image x:Name="BrandStripImage" Stretch="Uniform" MaxHeight="45" Visibility="Collapsed" />
            <TextBlock x:Name="BrandStripFallback" Text="FIAT  |  RENAULT  |  Jeep  |  RAM  |  OMODA  |  JAECOO"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#DD071724"
                       FontWeight="Bold" FontSize="16" />
        </Grid>
    </Grid>
</Window>
