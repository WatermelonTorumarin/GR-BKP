<Application x:Class="GRBKP.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:GRBKP.App"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Sistema de design reaproveitado da v0.9 (App.xaml original) — decidido explicitamente
             com o responsavel: o visual fica, o fluxo das paginas e novo (ver MainWindow.xaml). -->
        <LinearGradientBrush x:Key="AppBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFD8F5FF" Offset="0" />
            <GradientStop Color="#FF59BCE5" Offset="0.38" />
            <GradientStop Color="#FF09629B" Offset="1" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="PanelBrush" Color="#D92A5876" />
        <SolidColorBrush x:Key="PanelBorderBrush" Color="#745CD1FF" />

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#FF2F739C" />
            <Setter Property="BorderBrush" Value="#FF9EDFFF" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Padding" Value="20,9" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#FF3C8CB8" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#FF205B7D" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#8831495B" />
            <Setter Property="BorderBrush" Value="#AAE5F7FF" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#EFFFFFFF" />
            <Setter Property="Foreground" Value="#FF17394F" />
            <Setter Property="BorderBrush" Value="#FF8DD7F7" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="FontSize" Value="16" />
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#EFFFFFFF" />
            <Setter Property="Foreground" Value="#FF17394F" />
            <Setter Property="BorderBrush" Value="#FF8DD7F7" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontSize" Value="15" />
        </Style>

        <Style x:Key="ReviewLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#FFB9E9FF" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,5" />
        </Style>
        <Style x:Key="ReviewValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Margin" Value="0,5" />
        </Style>
    </Application.Resources>
</Application>
